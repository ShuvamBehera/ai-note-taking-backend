# Server Configuration
NODE_ENV=development
PORT=3001

# API Keys
OPENROUTER_KEY=your_openrouter_api_key_here
RUNWAY_API_KEY=your_runway_api_key_here

# Database (if using)
MONGODB_URI=mongodb://localhost:27017/autocreator
DATABASE_URL=postgresql://user:password@localhost:5432/autocreator

# Security
JWT_SECRET=your_jwt_secret_here
BCRYPT_ROUNDS=12

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Caching
CACHE_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info

# TTS Configuration
TTS_SERVICE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Video Generation
RUNWAY_API_URL=https://api.runwayml.com
VIDEO_WEBHOOK_URL=https://your-app.com/api/webhooks/video

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Storage (for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=autocreator-uploads
AWS_REGION=us-east-1

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token